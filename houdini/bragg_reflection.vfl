// Bragg Reflection Simulation
// Each layer deflects the beam by a set angle

// === Parameters ===
// Click the 'Plug' icon to create these sliders!
int num_layers = chi("num_layers"); 
float step_angle = radians(chf("deflection_per_layer")); // Set this to 4 in the slider

vector total_dir = normalize(v@v); // Use velocity or a custom 'incoming' vector
if(length(total_dir) < 0.001) total_dir = {0, -1, 0}; // Default downward if no vector exists

float total_efficiency = 1.0;

for (int i = 0; i < num_layers; i++) {
    // Standard Bragg deflection logic
    // We rotate the vector around the cross product of the normal to 'bend' it
    vector axis = normalize(cross(total_dir, @N));
    
    // Rotate total_dir by the step_angle around the calculated axis
    matrix3 rot = ident();
    rotate(rot, step_angle, axis);
    total_dir *= rot;

    // Simulate loss per layer
    total_efficiency *= 0.95; 
}

// === Outputs ===
v@v = total_dir; // Update velocity
@Cd = v@v * total_efficiency; // Color visualization