// File: houdini/vex/bragg_reflection.vfl

// Bragg Reflection Shader in VEX
// Simulates beam reflection through multiple Janus layers
// Each layer deflects the beam by 4 degrees (Bragg angle)
// Intended for use in an Attribute Wrangle or custom VOP node

// === Inputs ===
vector incoming = normalize(@N);        // Incident direction (use @N or custom attribute)
vector normal = normalize(@N);          // Surface normal (can be overridden)
float bragg_angle = radians(4);         // Bragg angle in radians (4°)
int num_layers = chi("num_layers");     // Number of Janus layers to simulate (default: 11)

vector total_dir = incoming;
float total_efficiency = 1.0;

for (int i = 0; i < num_layers; i++) {
    vector layer_normal = normalize(mix(normal, random(@P + i), 0.05)); // Perturbed normal
    vector reflection = reflect(total_dir, layer_normal);

    float angle_diff = acos(dot(reflection, total_dir));
    float efficiency = cos(angle_diff - bragg_angle);

    total_efficiency *= clamp(efficiency, 0, 1);
    total_dir = normalize(reflection);
}

// Output final direction and intensity
@N = total_dir;
@Cd = total_efficiency * total_dir; // Visualize strength and direction as color

